#!/bin/sh
. /usr/share/libubox/jshn.sh

status() {
	local pid rss memory profile
	pid=$(ubus call service list '{"name":"vless-lite","verbose":true}' | jsonfilter -e '@["vless-lite"].instances.instance1.pid')
	profile=$(ubus call service list '{"name":"vless-lite","verbose":true}' | jsonfilter -e '@["vless-lite"].instances.instance1.data.profile')
	rss=0
	case "$pid" in
		''|*[!0-9]*) pid=0 ;;
		*) rss=$(awk '/^VmRSS:/ {print $2}' "/proc/$pid/status" 2>/dev/null) ;;
	esac
	memory=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
	json_add_int pid "${pid:-0}"
	json_add_int rss_kib "${rss:-0}"
	json_add_int available_kib "${memory:-0}"
	json_add_string profile "$profile"
}

case "$1:$2" in
	list:) printf '%s\n' '{"status":{},"logs":{},"connect":{},"disconnect":{},"probe":{}}'; exit ;;
	call:probe)
		# Do not spawn multiple Go runtimes on a 64 MiB device.
		exec 9>/var/lock/vless-lite-probe.lock
		if ! flock -n 9; then
			printf '%s\n' '{"ok":false,"error":"Probe already running"}'
			exit
		fi
		if /usr/bin/xray-lite manager probe; then exit 0; fi
		printf '%s\n' '{"ok":false,"error":"HTTPS probe through active profile failed"}'
		exit ;;
esac

json_init
case "$1:$2" in
	call:status) status ;;
	call:logs)
		json_add_string logs "$(logread -e 'vless-lite' -l 60 | tail -c 12288)" ;;
	call:connect|call:disconnect)
		action=connect
		[ "$2" = connect ] || action=stop
		if /etc/init.d/vless-lite "$action" >/dev/null 2>&1; then
			json_add_boolean ok 1
		else
			json_add_boolean ok 0
			json_add_string error 'Operation failed. Check the selected profile, routing rules and logs.'
		fi ;;
	*) exit 1 ;;
esac
json_dump

